    {
      "id": "descriptors",
      "label": "Descriptions, not genres",
      "why": "True of a record, but no use for finding one: \"instrumental\" fits jazz, post-rock and dungeon synth alike.",
      "words": [
        "instrumental",
        "acoustic",
        "female vocalists",
        "male vocalists",
        "female vocals",
        "male vocals",
        "androgynous vocals",
        "live",
        "cover",
