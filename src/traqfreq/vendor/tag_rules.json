        "about music",
        "music",
        "genre",
        "abstract",
        "trash",
        "game",
        "no genre info",
        "non-music",
        "featuring",
        "skit",
        "self-titled",
        "silence",
        "good",
        "masterpiece",
        "sex",
        "hope",
        "calm",
