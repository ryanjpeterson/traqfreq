{
  "_about": "Genre tag rules for Library → Tags (tags.py). Read-only for now: they say what a tag should be called and which tags shouldn't exist, nothing is written to Plex. Order matters: split, then aliases, then rewrites, then aliases again, then junk, then case.",
  "niche_max": 1,
  "split": {
    "id": "split",
    "label": "One tag, one genre",
    "why": "A tag like \"Techno/Breaks\" or \"Pop, Rock\" is several genres crammed into one. Each gets its own tag.",
    "pattern": "\\s*[,;/|]\\s*|\\s+-\\s+|\\s*:\\s+"
  },
  "aliases": {
    "id": "aliases",
    "label": "Known aliases and typos",
    "why": "Same genre, different spelling. One name wins.",
    "map": {
      "hip-hop": "hip hop",
      "hiphop": "hip hop",
      "rap music": "rap",
      "synthpop": "synth-pop",
      "synth pop": "synth-pop",
      "elektro": "electro",
      "electronix": "electronic",
      "électronique": "electronic",
      "electronic music": "electronic",
      "industrial music": "industrial",
      "drum & bass": "drum and bass",
      "drum n bass": "drum and bass",
      "drum 'n' bass": "drum and bass",
      "drum'n'bass": "drum and bass",
      "dnb": "drum and bass",
      "d&b": "drum and bass",
      "rnb": "r&b",
      "r & b": "r&b",
      "r and b": "r&b",
      "rhythm and blues": "r&b",
      "rhythm & blues": "r&b",
      "prog rock": "progressive rock",
      "prog-rock": "progressive rock",
      "progressie rock": "progressive rock",
      "prog": "progressive rock",
      "prog metal": "progressive metal",
      "punk-rock": "punk rock",
      "jazz-rock": "jazz rock",
      "trip-hop": "trip hop",
      "glitch-hop": "glitch hop",
      "death-metal": "death metal",
      "death doom metal": "death-doom metal",
      "death doom": "death-doom metal",
      "death-doom": "death-doom metal",
      "death n roll": "death 'n' roll",
      "death'n'roll": "death 'n' roll",
      "death and roll": "death 'n' roll",
      "black n roll": "black 'n' roll",
      "black'n'roll": "black 'n' roll",
      "sludge": "sludge metal",
      "doom": "doom metal",
      "stoner": "stoner rock",
      "lofi": "lo-fi",
      "lo fi": "lo-fi",
      "instumental hip hop": "instrumental hip hop",
      "bop": "bebop",
      "neo-soul": "neo soul",
      "nu-metal": "nu metal",
      "nu-disco": "nu disco",
      "alt country": "alt-country",
      "alternative rnb": "alternative r&b",
      "future rnb": "future r&b",
      "stage and screen": "soundtrack",
      "stage & screen": "soundtrack",
      "game soundtrack": "video game music",
      "ost": "soundtrack",
      "2-step": "2-step garage",
      "downtempo/chillout": "downtempo",
      "chillout": "downtempo",
      "funk soul": "funk",
      "jazz-funk": "jazz funk",
      "instrumentalhiphop": "instrumental hip hop",
      "ghetto tech": "ghettotech",
      "alternative & indie": "indie",
      "dark wave": "darkwave",
      "vgm": "video game music"
    }
  },
  "rewrites": [
    {
      "id": "post-hyphen",
      "label": "post- takes a hyphen",
      "why": "Post-punk, post-hardcore, post-rock: the prefix is hyphenated, never spaced or glued on.",
      "pattern": "\\bpost(?:\\s+|_|(?=punk|hardcore|rock|metal|bop|black|grunge|industrial|disco))",
      "replace": "post-"
    },
    {
      "id": "prefix-hyphen",
      "label": "neo-, proto-, avant- take a hyphen",
      "why": "Neo-psychedelia, proto-punk, avant-garde: hyphenated prefixes, same as post-.",
      "pattern": "\\b(neo|proto|avant)\\s+(?=garde|psychedelia|punk|prog|classical|folk)",
      "replace": "\\1-"
    },
    {
      "id": "hip-hop",
      "label": "Hip hop has no hyphen",
      "why": "\"Hip Hop\", \"Alternative Hip Hop\": the way MusicBrainz and most of your library spell it.",
      "pattern": "\\bhip-hop\\b",
      "replace": "hip hop"
    },
    {
      "id": "and",
      "label": "\"and\", not \"&\"",
      "why": "\"Drum and Bass\", not \"Drum & Bass\". R&B keeps its ampersand, because it's R&B.",
      "pattern": "(?<!\\br)\\s*&\\s*(?!b\\b)",
      "replace": " and "
    }
  ],
  "junk": [
    {
      "id": "decades",
      "label": "Decades aren't genres",
      "why": "\"80s\" says when, not what. The year is already on the album.",
      "pattern": "^(\\d0|(19|20)\\d0)'?s$|^(19|20)\\d\\d$"
    },
    {
      "id": "places",
      "label": "Places aren't genres",
      "why": "Where a band is from lives on the artist (MusicBrainz knows), not in its genre.",
      "words": [
        "british",
        "english",
        "american",
