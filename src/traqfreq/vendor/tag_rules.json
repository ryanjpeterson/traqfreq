        "actors",
        "composers"
      ]
    },
    {
      "id": "personal",
      "label": "Personal notes and labels",
      "why": "\"Seen live\", favourites, awards, record labels and radio shows are bookkeeping, not genres.",
      "words": [
        "seen live",
        "favorites",
        "favourites",
        "favorite",
        "favourite",
        "owned",
        "albums i own",
        "my collection",
        "to listen",
        "wishlist",
        "awesome",
        "best",
        "classic",
        "dolphin on cover",
        "ninja tune",
        "warp",
        "bowie",
        "travis scott",
        "assassin's creed",
        "eigen makelij",
        "eccojams",
        "ubisoft",
        "musicologist"
      ],
      "pattern": "\\b(fm|radio|award|with dj|playlist|show with|records|chronically|meltdown|jazzthing|folker)\\b|qobuz|\\d{2}[-.–]\\d{2}|^[^a-z0-9]+$"
    },
    {
      "id": "artist-names",
      "label": "Artist names aren't genres",
      "why": "A tag that's just the name of an artist in your library. They have a page for that.",
      "artists": true
    }
  ],
  "case": {
    "id": "case",
    "label": "Title Case, with the acronyms in capitals",
    "why": "\"Black Metal\", \"Post-Hardcore\", \"IDM\", \"UK Garage\", \"Drum and Bass\": one style for every tag, like Plex shows them.",
    "upper": [
      "idm",
      "ebm",
      "edm",
      "uk",
      "us",
      "dj",
      "r&b",
      "nwobhm",
      "nyhc",
      "dsbm",
      "ost"
    ],
    "lower": [
      "and",
      "of",
      "the",
      "n",
      "'n'",
      "in",
      "a"
    ]
  },
  "broad": {
    "_about": "Every specific genre also carries its broad parent: anything metal gets \"Metal\". The family comes from genres.family() (the same families as Library → Genres); overrides are checked first, in order.",
    "id": "broad",
    "label": "Specific tags bring their broad parent",
    "why": "An album tagged Black Metal should also say Metal, so \"all my metal\" finds it.",
    "families": {
      "Metal": "Metal",
      "Punk & hardcore": "Punk",
      "Hip hop": "Hip Hop",
      "Electronic": "Electronic",
      "Jazz": "Jazz",
      "Blues & soul": "Soul",
      "Folk & country": "Folk",
      "Classical": "Classical",
      "Reggae": "Reggae",
      "Pop": "Pop",
      "Rock": "Rock"
    },
    "overrides": [
      {
        "pattern": "^(blackgaze)$",
        "tag": "Metal"
      },
      {
        "pattern": "^(d-beat)$",
        "tag": "Punk"
      },
      {
        "pattern": "^(darkwave|coldwave|ethereal wave|minimal synth|footwork|juke|breakcore|hardstyle|wonky|deconstructed club|big beat|berlin school|ghettotech|halftime|plunderphonics|progressive breaks|nightcore|kosmische)$",
        "tag": "Electronic"
      },
      {
        "pattern": "^(neo-psychedelia|madchester|crank wave|canterbury scene|zeuhl|avant-prog|symphonic prog|zolo|neue deutsche welle|mod revival|new rave|psychobilly|gothabilly)$",
        "tag": "Rock"
      },
      {
        "pattern": "^(bossa nova|third stream)$",
        "tag": "Jazz"
      },
      {
        "pattern": "^(nederhop|turntablism)$",
        "tag": "Hip Hop"
      },
      {
        "pattern": "^(two-tone)$",
        "tag": "Reggae"
      },
      {
        "pattern": "^(adult contemporary|digicore)$",
        "tag": "Pop"
      },
      {
        "pattern": "^(uk funky|uk garage|future garage|2-step garage)$",
        "tag": "Electronic"
      },
      {
        "pattern": "^new romantic$",
        "tag": "Rock"
      },
      {
        "pattern": "^(baroque pop|chamber pop)$",
        "tag": "Pop"
      },
      {
        "pattern": "new age",
        "tag": null
      },
      {
        "pattern": "^(synth-pop|electropop|synthwave|futurepop|indietronica|chillwave|vaporwave)$",
        "tag": "Electronic"
      },
      {
        "pattern": "punk blues|blues rock|^blues|chicago blues",
        "tag": "Blues"
      },
      {
        "pattern": "^(funk|p-funk|disco|post-disco|nu disco|jazz funk|dark disco)$",
        "tag": "Funk"
      },
      {
        "pattern": "country|bluegrass|americana|alt-country",
        "tag": "Country"
      },
      {
        "pattern": "^(r&b|alternative r&b|contemporary r&b|future r&b)$",
        "tag": "R&B"
      },
      {
        "pattern": "^(soundtrack|video game music|cinematic classical)$",
        "tag": null
      },
      {
        "pattern": "^(noise|experimental|avant-garde|drone|lo-fi|minimal|instrumental)$",
        "tag": null
      }
    ]
  }
