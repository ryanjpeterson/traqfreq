# traqfreq settings. Copy to .env next to docker-compose.yml (never commit .env; it is git- and
# docker-ignored). Every value is optional unless it says otherwise; empty = the default or "not set up".
# Secrets (keys, passwords, tokens) are never shown on a page, logged, or sent anywhere but their own server.
#
# Sections follow the build phases (docs/specs/README.md). "Read now" means the code reads it today;
# "Planned" names what a later phase will need, so the deploy can be prepared. Planned names may still
# change in that phase's spec; jimbo-dj's equivalent is given so the values can be copied from its .env.

# --- P0 shell: read now -----------------------------------------------------------------------------
# jimbo-dj's data folder on the host, mounted read-only at /legacy (compose). Default ../jimbo-dj/data.
# JIMBODJ_DATA_DIR=../jimbo-dj/data
# traqfreq's own data folder on the host (its cache database), mounted at /data. Default ./data.
# TRAQFREQ_DATA_DIR=./data
# Host port. Default 4492 (jimbo-dj is 4490, jimbodj-text 4491).
# TRAQFREQ_PORT=4492
# The listening time zone when jimbo-dj's meta history_tz isn't set. Default America/Denver (compose).
TZ=America/Denver

# Outside Docker only (uv run traqfreq); compose sets these itself:
# TRAQFREQ_LEGACY_DB=../jimbo-dj/data/jimbodj.sqlite   # jimbo-dj's database, opened read-only
# TRAQFREQ_HOST=0.0.0.0
# TRAQFREQ_WEB_DIR=web/dist

# --- P1–P2 HISTORY, LIBRARY: read now ---------------------------------------------------------------
# Modules to switch on besides LIBRARY and SETUP (always on): letters or names, e.g. H or H,TAGS.
TRAQFREQ_MODULES=H

# --- P3 SERVERS: read now (docs/specs/t13-servers.md) -----------------------------------------------
# Plex's music folders as Plex sees them, comma-separated. Only if jimbo-dj stored none (it normally
# has its PLEX_PATH_MAP folders); otherwise leave empty.
# TRAQFREQ_PLEX_ROOTS=
# Jellyfin (T17): URL as the traqfreq container reaches it, an API key (Dashboard -> API Keys), and
# optionally the user whose play counts are shown. Read-only: GET requests only.
TRAQFREQ_JELLYFIN_URL=
TRAQFREQ_JELLYFIN_KEY=
# TRAQFREQ_JELLYFIN_USER=
# Navidrome (T18): URL, a user and its password (Subsonic token auth; nothing is written). For file
# matching, Navidrome must report real paths: ND_SUBSONIC_DEFAULTREPORTREALPATH=true in Navidrome's own
# settings, or "Report Real Path" on the player traqfreq uses.
TRAQFREQ_NAVIDROME_URL=
TRAQFREQ_NAVIDROME_USER=
TRAQFREQ_NAVIDROME_PASSWORD=
# Navidrome's music folder as its real paths show it (e.g. /music), comma-separated. Only if the folder every
# real path shares is too deep (all songs under one artist); otherwise leave empty.
# TRAQFREQ_NAVIDROME_ROOTS=

# --- P4 TAGS, P5 PLAYLISTS preview: read now --------------------------------------------------------
# Both read jimbo-dj's database only (tags, playlists and the Junction preview), through the settings above.
# The Ask box (T28) turns words into a line. By sound: jimbo-dj's CLAP text server, jimbodj-text (native on the
# mini, :4491; jimbo-dj: JIMBODJ_TEXT_URL). It only turns words into numbers. Compose sets this default; empty
# outside Docker = words aren't compared by sound (typed facet:value parts still work).
# TRAQFREQ_TEXT_URL=http://host.docker.internal:4491
# Optionally a local Ollama, off by default: it reads the words into styles, moods and decades the library has
# (anything else is dropped). Local only, no paid APIs.
# TRAQFREQ_OLLAMA_URL=http://host.docker.internal:11434
# TRAQFREQ_OLLAMA_MODEL=qwen2.5:7b

# --- P6 cut-overs: planned (traqfreq takes over jimbo-dj's writes, one at a time) ---------------------
# Plex, for syncs, plays and Fix in Plex (jimbo-dj: PLEX_URL, PLEX_TOKEN, PLEX_MUSIC_SECTION, PLEX_PATH_MAP).
# TRAQFREQ_PLEX_URL=http://host.docker.internal:32400
# TRAQFREQ_PLEX_TOKEN=
# TRAQFREQ_PLEX_MUSIC_SECTION=Music
# TRAQFREQ_PLEX_PATH_MAP=/data/music=/music
# The music folders, mounted read-only (analysis, file checks; jimbo-dj: MUSIC_DIR_1..4, MUSIC_MOUNT_MODE).
# TRAQFREQ_MUSIC_DIR_1=
# Playlists traqfreq owns: it only ever creates, replaces or deletes playlists with this prefix
# (jimbo-dj: DJ_PLAYLIST_PREFIX).
# TRAQFREQ_PLAYLIST_PREFIX=
# History imports: a folder of Spotify, Apple Music and Last.fm exports, read in place (jimbo-dj:
# HISTORY_EXPORTS_DIR), and Last.fm's API (jimbo-dj: LASTFM_USER, LASTFM_API_KEY; free).
# TRAQFREQ_HISTORY_EXPORTS_DIR=
# TRAQFREQ_LASTFM_USER=
# TRAQFREQ_LASTFM_API_KEY=
# Scheduled jobs, times in TZ (jimbo-dj: SCHEDULE_SYNC, SCHEDULE_DAILY_MIX, …; JIMBODJ_SCHEDULER=off).
# TRAQFREQ_SCHEDULER=off
# MusicBrainz lookups: free, no key, sends only MusicBrainz IDs; 0 turns them off (jimbo-dj: MUSICBRAINZ).
# TRAQFREQ_MUSICBRAINZ=1

# --- P7 DISCOVER, MIXES, FETCH, language loop: planned ----------------------------------------------
# (TRAQFREQ_TEXT_URL and TRAQFREQ_OLLAMA_URL are read from T28: see P5 above.)
# setlist.fm, for live sets (jimbo-dj: SETLISTFM_API_KEY; free key).
# TRAQFREQ_SETLISTFM_API_KEY=
# Push notifications (jimbo-notify standard: self-hosted ntfy).
# TRAQFREQ_NTFY_URL=
# TRAQFREQ_NTFY_TOPIC=

# --- P8 retire jimbo-dj: planned ----------------------------------------------------------------------
# When jimbo-dj is off, traqfreq's own database replaces TRAQFREQ_LEGACY_DB / JIMBODJ_DATA_DIR; the
# settings above stay.
